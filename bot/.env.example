# ── Discord ────────────────────────────────────────────────────────────────────
# Pflicht: Bot-Token aus dem Discord Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=

# Optional: Guild-ID. Dann erscheinen Slash-Commands sofort statt nach bis zu 1 h.
# Rechtsklick auf den Server → "Server-ID kopieren" (Entwicklermodus aktivieren).
# Test: 1561751762426273892 · Produktion: 1551691741541830768 (siehe AGENTS.md)
DISCORD_GUILD_ID=

# Optional: Allowlist (kommagetrennte IDs). Leer = alle dürfen den Bot benutzen.
# ACHTUNG: Der Bot kann Dateien ändern und Befehle ausführen.
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=

# ── OpenCode ──────────────────────────────────────────────────────────────────
# Leer lassen, um den lokalen OpenCode-Hintergrunddienst automatisch zu nutzen.
# Nur für einen entfernten Server setzen, z. B. http://127.0.0.1:4096
OPENCODE_URL=
# Authentifizierung für einen entfernten Server (eine Variante reicht):
# OPENCODE_AUTH=user:passwort
# OPENCODE_TOKEN=token
OPENCODE_AUTH=
OPENCODE_TOKEN=

# Projektverzeichnis, in dem OpenCode arbeitet. Leer = Ordner des Bots (bot/).
# Um im Website-Repo zu arbeiten, ../ eintragen oder /ask directory:.. nutzen.
OPENCODE_DIRECTORY=

# Optionaler Standard-Agent und Standardmodell (provider/model).
OPENCODE_AGENT=
OPENCODE_MODEL=

# Harte Obergrenze für eine Aufgabe (30 Minuten).
OPENCODE_TIMEOUT_MS=1800000

# ── Darstellung ───────────────────────────────────────────────────────────────
# Abstand zwischen Live-Updates in ms (Discord-Limit beachten).
STREAM_UPDATE_MS=1500
# false = keine Live-Vorschau, nur das Endergebnis.
STREAM_OUTPUT=true

# Wo die Channel→Session-Zuordnung gespeichert wird.
STATE_FILE=.data/state.json
