# ── Discord: Gesetzes-Sync (scripts/) ──────────────────────────────────────────
# Nur für lokale Tests; in GitHub Actions kommen die Werte aus den Secrets.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Übersichts-Channel, z. B. #gestze
DISCORD_INDEX_CHANNEL_ID=

# Optional
CONTENT_DIR=content
DRY_RUN=true

# ── Supabase ──────────────────────────────────────────────────────────────────
# Projekt-URL und öffentlicher anon/publishable key. Niemals den service_role key eintragen.
# Ohne diese Werte läuft die Website weiter mit Mock-Daten.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Website ───────────────────────────────────────────────────────────────────
# Kanonische URL für Metadaten, Sitemap und Robots.
# Leer = Fallback auf https://freistaat-dashboard.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Discord-Bot (bot/) ────────────────────────────────────────────────────────
# Eigene Datei bot/.env – siehe bot/.env.example. Der Bot liest DISCORD_TOKEN,
# alle weiteren Werte (DISCORD_GUILD_ID, OPENCODE_*, STATE_FILE …) stehen dort.
